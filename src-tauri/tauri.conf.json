{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "来搜工作台",
  "version": "1.0.11",
  "identifier": "com.lsou.workbench",
  "build": {
    "frontendDist": "boot"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "来搜 · 国际站经营工作台",
        "width": 1440,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "payload/": "payload/",
      "runtime/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
