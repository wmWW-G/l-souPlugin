    "icbu tm list-conversation-msg": {
      "schema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "description": "会话 ID，可从 query_recent_conversation 返回的 conversations[].conversationId 获取。",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "description": "单次查询消息条数。",
            "default": 20
          },
          "domain": {
            "type": "string",
            "description": "租户类型。不确定时使用默认值 icbu。",
            "enum": [
              "icbu",
              "accio"
            ],
            "default": "icbu"
          },
          "forward": {
            "type": "boolean",
            "description": "消息查询方向。false 表示向时间减小方向查询，true 表示向时间增大方向查询。",
            "default": false
          },
          "limitTimeStamp": {
            "type": "integer",
            "description": "分页游标时间戳（Unix 毫秒）。首次以 forward=false 向历史查询时可省略，CLI 自动注入当前时间；后续分页必须显式传上一页返回的 cursor。forward=true 时必须显式传入。"
          },
          "selfAliId": {
            "type": "integer",
            "description": "必须使用 conversationId 对应会话的 sellerAliId。仅当该 sellerAliId 等于通过 workctl workflow chat-analysis resolve-id 生成的 account_identity.json 中 CURRENT_SELF_ALIID 时可省略，省略后自动注入当前账号；否则必须显式传入会话记录中的 sellerAliId。不要从 conversationId 拆解或猜测。"
